# Copy to .env (git-ignored) and adjust. Read by docker-compose.yml and `make run-api`.

# Required (non-empty) as soon as the API is reachable from anything but 127.0.0.1.
# Simulation-control endpoints are open when unset. Must match VITE_API_KEY in the frontend build.
CITYMIND_API_KEY=

# Comma-separated browser origins allowed by CORS.
CITYMIND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Ports (host side)
API_PORT=8000
FRONTEND_PORT=8080

# Set automatically by scripts/setup_sumo.sh (.env.sumo) or the eclipse-sumo wheel; override if needed.
# SUMO_HOME=
