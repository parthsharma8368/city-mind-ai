# Copy to .env.local and adjust for your deployment.
#
# Development: both are optional. When unset the client uses
#   VITE_API_URL -> http://127.0.0.1:8000/api
#   VITE_WS_URL  -> derived from VITE_API_URL (ws://127.0.0.1:8000/ws/simulation)
# Production builds (`vite build`) should set VITE_API_URL (the build warns without it).
VITE_API_URL=http://127.0.0.1:8000/api
VITE_WS_URL=ws://127.0.0.1:8000/ws/simulation

# NOTE: do NOT add API keys or other secrets here. Anything prefixed VITE_ is
# inlined into the public JS bundle and readable by every visitor.
