# Copy to .env.local and adjust for your deployment.
# Falls back to http://localhost:8000 (API) / ws://localhost:8000 (WS) when unset.
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws/simulation

# Must match CITYMIND_API_KEY on the backend if it's set there (required once
# the API is reachable from anywhere other than 127.0.0.1). Leave unset for
# local dev against an unauthenticated backend.
VITE_API_KEY=
